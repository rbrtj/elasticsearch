Project[[result{r}#0, step{r}#1, tier{r}#2 AS tier#3]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#4) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, tier{r}#2],[SUM(result{r}#5,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#4, step{r}#1, tier{r}#2]]
          \_Eval[[COALESCE(REGEXEXPAND(COALESCE(region{f}#6,[KEYWORD]),(.+)[KEYWORD],$1[KEYWORD]),[KEYWORD]) AS tier#2]]
            \_UnpackDims[_$packed_grouping_dims{r}#7,[region{r}#6]]
              \_Aggregate[[step{r}#1, _tsid{m}#8, _$packed_dims{f$}#9],[VALUES(LASTOVERTIME_$1{r}#10,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#5, step{r}#1 AS step#1, _$packed_dims{f$}#9 AS _$packed_grouping_dims#7]]
                \_PackDims[[region{r}#11],_$packed_dims{f$}#9,true]
                  \_TimeSeriesAggregate[[_tsid{m}#8, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#12,@timestamp{f}#13,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#10, DIMENSIONVALUES(region{f}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS region#11, _tsid{m}#8, step{r}#1],BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]),@timestamp{f}#13,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#13, client.ip{f}#14, cluster{f}#15, event{f}#16, event_city{f}#17, event_city_boundary{f}#18, event_location{f}#19, event_log{f}#20, event_shape{f}#21, events_received{f}#22, network.bytes_in{f}#12, network.cost{f}#23, network.eth0.currently_connected_clients{f}#24, network.eth0.firmware_version{f}#25, network.eth0.last_up{f}#26, network.eth0.rx{f}#27, network.eth0.tx{f}#28, network.eth0.up{f}#29, network.total_bytes_in{f}#30, network.total_bytes_out{f}#31, network.total_cost{f}#32, pod{f}#33, region{f}#6, _tsid{m}#8]