Project[[result{r}#0, step{r}#1, cluster{f}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[$$SUM$result$0{r$}#3 / $$COUNT$result$1{r$}#4 AS result#5, TODOUBLE(result{r}#5) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, cluster{r}#2],[SUM(result{r}#6,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$result$0#3, COUNT(result{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$result$1#4, step{r}#1, cluster{r}#2]]
          \_UnpackDims[_$packed_grouping_dims{r}#7,[_timeseries$__name__{r}#8, cluster{r}#2]]
            \_Aggregate[[step{r}#1, _$packed_dims{f$}#9],[SUM(LASTOVERTIME_$1{r}#10,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#6, step{r}#1 AS step#1, _$packed_dims{f$}#9 AS _$packed_grouping_dims#7]]
              \_PackDims[[_timeseries$__name__{r}#11, cluster{r}#12],_$packed_dims{f$}#9,true]
                \_Eval[[TOTIMESERIES($$_timeseries$__name__$series{r}#13) AS _timeseries$__name__#11]]
                  \_TimeSeriesAggregate[[_tsid{m}#14, step{r}#1],[LASTOVERTIME(network.cost{f}#15,@timestamp{f}#16,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#10, DIMENSIONVALUES(_timeseries{f$}#17,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$_timeseries$__name__$series#13, DIMENSIONVALUES(cluster{f}#2,true[BOOLEAN],PT0S[TIME_DURATION]) AS cluster#12, step{r}#1],BUCKET(@timestamp{f}#16,PT1H[TIME_DURATION]),@timestamp{f}#16,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#16,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#16, client.ip{f}#18, cluster{f}#2, event{f}#19, event_city{f}#20, event_city_boundary{f}#21, event_location{f}#22, event_log{f}#23, event_shape{f}#24, events_received{f}#25, network.bytes_in{f}#26, network.cost{f}#15, network.eth0.currently_connected_clients{f}#27, network.eth0.firmware_version{f}#28, network.eth0.last_up{f}#29, network.eth0.rx{f}#30, network.eth0.tx{f}#31, network.eth0.up{f}#32, network.total_bytes_in{f}#33, network.total_bytes_out{f}#34, network.total_cost{f}#35, pod{f}#36, region{f}#37, _timeseries{f$}#17, _tsid{m}#14]